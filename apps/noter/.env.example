# Database (for session storage)
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/mydb

# Sui network
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_APP_URL=http://localhost:3002

# OpenRouter (for AI note features)
OPENROUTER_API_KEY=

# Google OAuth — required for zkLogin (Google sign-in)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add NEXT_PUBLIC_REDIRECT_URL to Authorized redirect URIs in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_REDIRECT_URL=http://localhost:5173/auth/callback

# MemWal on-chain contract IDs (testnet)
NEXT_PUBLIC_MEMWAL_PACKAGE_ID=0xcf6ad755a1cdff7217865c796778fabe5aa399cb0cf2eba986f4b582047229c6
NEXT_PUBLIC_MEMWAL_REGISTRY_ID=0xe80f2feec1c139616a86c9f71210152e2a7ca552b20841f2e192f99f75864437
